.DS_Store
node_modules/
*.log

# Local Python environment for tools/generate-audio.mjs.
.venv/

# Generated lesson audio IS committed on purpose: GitHub Pages serves it to
# phones and tablets, which cannot run the generator themselves. Regenerate
# with `npm run audio` after adding lessons.

# Whisper models are large and downloaded on demand by tools/align-media.mjs.
models/

# Private lesson packs built from your own media. Never publish these.
*.echopack

# TTS listening-test output; regenerate with tools/tts_bakeoff.py
bakeoff/

# Python environments for the neural TTS engines (torch pulls in gigabytes).
# One per engine because Chatterbox and Dia pin conflicting torch versions.
.venv-tts/
.venv-dia/

__pycache__/
